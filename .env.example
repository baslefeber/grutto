# Model provider: bedrock (default) or anthropic
GRUTTO_MODEL_PROVIDER=bedrock

# Only needed when GRUTTO_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Data source: fixture (default, recorded real data) or connect (your Garmin)
GRUTTO_SOURCE=fixture

# Only needed when GRUTTO_SOURCE=connect. Your own account only.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
